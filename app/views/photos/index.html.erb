<% if turbo_frame_request? %>
  <%= turbo_frame_tag "photos_page_#{@page}" do %>
    <div class="space-y-8 mt-8">
      <%= render partial: "photos/days", locals: { grouped_photos: @grouped_photos } %>
    </div>

    <% if @next_page %>
      <turbo-frame id="photos_page_<%= @next_page %>" class="block mt-8">
        <div class="text-center">
          <%= link_to "Load 3 more days",
                      device_photos_path(@device, page: @next_page),
                      class: "inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-5 py-2.5 text-sm font-semibold text-sky-400 hover:border-sky-500 hover:bg-slate-800 hover:text-sky-300 transition shadow-sm",
                      data: { turbo_frame: "photos_page_#{@next_page}" } %>
        </div>
      </turbo-frame>
    <% else %>
      <p class="mt-8 text-center text-xs text-slate-500">No older photos found.</p>
    <% end %>
  <% end %>
<% else %>
  <% content_for :title, "#{@device.name} · Photo History" %>

  <header class="mb-8 border-b border-slate-800 pb-6">
    <div class="mb-4">
      <%= link_to root_path(device_id: @device.tuya_device_id),
                  class: "inline-flex items-center gap-2 text-sm font-medium text-sky-400 hover:text-sky-300 transition" do %>
        <span aria-hidden="true">&larr;</span> Back to Dashboard
      <% end %>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Photo History
          </h1>

          <span class="rounded-md bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-300">
            <%= @device.name %>
          </span>

          <% if @device.online? %>
            <span class="inline-flex items-center gap-2 rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-300 ring-1 ring-inset ring-emerald-500/30">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Online
            </span>
          <% else %>
            <span class="inline-flex items-center gap-2 rounded-full bg-amber-500/15 px-3 py-1 text-xs font-semibold text-amber-300 ring-1 ring-inset ring-amber-500/30">
              <span class="h-2 w-2 rounded-full bg-amber-400"></span>
              Stale / Offline
            </span>
          <% end %>
        </div>

        <p class="mt-1.5 text-sm text-slate-400">
          Daytime camera captures grouped by day · Atlantic time (ADT/AST)
        </p>
      </div>
    </div>
  </header>

  <% if @grouped_photos.any? %>
    <div id="photos-days-stream" class="space-y-8">
      <%= render partial: "photos/days", locals: { grouped_photos: @grouped_photos } %>
    </div>

    <% if @next_page %>
      <turbo-frame id="photos_page_<%= @next_page %>" class="block mt-8">
        <div class="text-center">
          <%= link_to "Load 3 more days",
                      device_photos_path(@device, page: @next_page),
                      class: "inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-5 py-2.5 text-sm font-semibold text-sky-400 hover:border-sky-500 hover:bg-slate-800 hover:text-sky-300 transition shadow-sm",
                      data: { turbo_frame: "photos_page_#{@next_page}" } %>
        </div>
      </turbo-frame>
    <% end %>
  <% else %>
    <div class="flex h-56 flex-col items-center justify-center rounded-2xl border border-dashed border-slate-800 bg-slate-900/40 p-8 text-center">
      <p class="text-base font-medium text-slate-300">No daytime photos uploaded for this device yet.</p>
      <p class="mt-2 text-xs text-slate-500">
        Photos sent to <code class="rounded bg-slate-900 px-1.5 py-0.5 font-mono text-xs text-sky-300">POST /api/v1/photos</code> will appear here.
      </p>
    </div>
  <% end %>
<% end %>
