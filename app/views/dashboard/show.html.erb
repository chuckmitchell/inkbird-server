<% content_for :title, @device ? "#{@device.name} · Inkbird Telemetry" : "Inkbird ITC-308 Telemetry" %>

<div
  data-controller="unit-toggle"
  data-unit-toggle-unit-value="<%= @unit %>"
  data-unit-toggle-chart-data-c-value="<%= (@chart_data_c || {}).to_json %>"
  data-unit-toggle-chart-data-f-value="<%= (@chart_data_f || {}).to_json %>"
>
  <header class="mb-8 flex flex-col gap-4 border-b border-slate-800 pb-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
          <%= @device&.name || "Cottage ITC-308" %>
        </h1>

        <% if @device %>
          <% if @device.online? %>
            <span class="inline-flex items-center gap-2 rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-300 ring-1 ring-inset ring-emerald-500/30">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Online
            </span>
          <% else %>
            <span class="inline-flex items-center gap-2 rounded-full bg-amber-500/15 px-3 py-1 text-xs font-semibold text-amber-300 ring-1 ring-inset ring-amber-500/30">
              <span class="h-2 w-2 rounded-full bg-amber-400"></span>
              Stale / Offline
            </span>
          <% end %>
        <% else %>
          <span class="inline-flex items-center gap-2 rounded-full bg-slate-800 px-3 py-1 text-xs font-medium text-slate-400 ring-1 ring-inset ring-slate-700">
            Awaiting First Payload
          </span>
        <% end %>
      </div>

      <p class="mt-1.5 text-sm text-slate-400">
        <% if @device %>
          Device ID: <code class="rounded bg-slate-900 px-1.5 py-0.5 font-mono text-xs text-slate-300"><%= @device.tuya_device_id %></code>
          <% if @device.last_seen_at %>
            · Last seen <time datetime="<%= @device.last_seen_at.iso8601 %>" title="<%= friendly_timestamp(@device.last_seen_at) %>" class="font-medium text-slate-200 cursor-help border-b border-dotted border-slate-600"><%= time_ago_in_words(@device.last_seen_at) %> ago</time>
          <% end %>
          <% if @device.next_poll_at %>
            · Next Expected <time datetime="<%= @device.next_poll_at.iso8601 %>" title="<%= friendly_timestamp(@device.next_poll_at) %>" class="font-medium text-slate-200 cursor-help border-b border-dotted border-slate-600"><%= relative_poll_time(@device.next_poll_at) %></time>
          <% end %>
        <% else %>
          Inkbird ITC-308 Wi-Fi Smart Thermostat Telemetry Server
        <% end %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3 sm:justify-end">
      <% if @devices.size > 1 %>
        <nav aria-label="Select thermostat device" class="flex items-center gap-2">
          <% @devices.each do |dev| %>
            <% active = dev.id == @device&.id %>
            <%= link_to root_path(device_id: dev.tuya_device_id, range: @range),
                  class: "rounded-lg px-3 py-1.5 text-xs font-medium transition #{active ? 'bg-sky-500 text-slate-950 font-semibold' : 'bg-slate-900 text-slate-300 hover:bg-slate-800'}" do %>
              <%= dev.name %> (<%= dev.tuya_device_id.last(6) %>)
            <% end %>
          <% end %>
        </nav>
      <% end %>

      <div role="group" aria-label="Temperature unit selection" class="inline-flex rounded-xl bg-slate-950 p-1 ring-1 ring-inset ring-slate-800">
        <button
          type="button"
          data-unit-toggle-target="button"
          data-unit="C"
          data-action="click->unit-toggle#select"
          class="rounded-lg px-3 py-1.5 text-xs font-semibold transition cursor-pointer <%= @unit == 'F' ? 'text-slate-400 hover:text-white' : 'bg-sky-500 text-slate-950 shadow-sm' %>"
          aria-pressed="<%= @unit == 'F' ? 'false' : 'true' %>"
          title="Display temperatures in Celsius"
        >
          °C
        </button>
        <button
          type="button"
          data-unit-toggle-target="button"
          data-unit="F"
          data-action="click->unit-toggle#select"
          class="rounded-lg px-3 py-1.5 text-xs font-semibold transition cursor-pointer <%= @unit == 'F' ? 'bg-sky-500 text-slate-950 shadow-sm' : 'text-slate-400 hover:text-white' %>"
          aria-pressed="<%= @unit == 'F' ? 'true' : 'false' %>"
          title="Display temperatures in Fahrenheit"
        >
          °F
        </button>
      </div>
    </div>
  </header>

  <% if @device %>
    <section aria-label="Current Thermostat Status" class="status-card-grid mb-8">
      <article class="status-card rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-sm">
        <header class="flex items-center justify-between">
          <h2 class="text-sm font-medium text-slate-400">Current Temperature</h2>
        </header>
        <div class="flex items-baseline gap-3">
          <p class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
            <span data-unit-toggle-target="celsius" class="<%= 'hidden' if @unit == 'F' %>">
              <%= @device.last_temp_c.present? ? sprintf("%.1f°C", @device.last_temp_c) : "—" %>
            </span>
            <span data-unit-toggle-target="fahrenheit" class="<%= 'hidden' if @unit != 'F' %>">
              <%= @device.effective_last_temp_f.present? ? sprintf("%.1f°F", @device.effective_last_temp_f) : "—" %>
            </span>
          </p>
        </div>
        <footer class="border-t border-slate-800/80 pt-3 text-xs text-slate-400">
          <% if @device.last_seen_at %>
            Updated <%= time_ago_in_words(@device.last_seen_at) %> ago
          <% else %>
            No temperature recorded yet
          <% end %>
        </footer>
      </article>

      <article class="status-card rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-sm">
        <header class="flex items-center justify-between">
          <h2 class="text-sm font-medium text-slate-400"><%= @range_meta[:label] %> Summary</h2>
          <span class="text-xs font-mono text-slate-400"><%= @stats[:count] %> readings</span>
        </header>
        <dl class="grid grid-cols-3 gap-2 text-center">
          <div class="rounded-lg bg-slate-950/60 p-2.5">
            <dt class="text-xs text-slate-400">Min</dt>
            <dd class="mt-0.5 text-lg font-semibold text-cyan-300">
              <span data-unit-toggle-target="celsius" class="<%= 'hidden' if @unit == 'F' %>">
                <%= @stats[:min_c].present? ? "#{@stats[:min_c]}°C" : "—" %>
              </span>
              <span data-unit-toggle-target="fahrenheit" class="<%= 'hidden' if @unit != 'F' %>">
                <%= @stats[:min_f].present? ? "#{@stats[:min_f]}°F" : "—" %>
              </span>
            </dd>
          </div>
          <div class="rounded-lg bg-slate-950/60 p-2.5">
            <dt class="text-xs text-slate-400">Avg</dt>
            <dd class="mt-0.5 text-lg font-semibold text-white">
              <span data-unit-toggle-target="celsius" class="<%= 'hidden' if @unit == 'F' %>">
                <%= @stats[:avg_c].present? ? "#{@stats[:avg_c]}°C" : "—" %>
              </span>
              <span data-unit-toggle-target="fahrenheit" class="<%= 'hidden' if @unit != 'F' %>">
                <%= @stats[:avg_f].present? ? "#{@stats[:avg_f]}°F" : "—" %>
              </span>
            </dd>
          </div>
          <div class="rounded-lg bg-slate-950/60 p-2.5">
            <dt class="text-xs text-slate-400">Max</dt>
            <dd class="mt-0.5 text-lg font-semibold text-amber-300">
              <span data-unit-toggle-target="celsius" class="<%= 'hidden' if @unit == 'F' %>">
                <%= @stats[:max_c].present? ? "#{@stats[:max_c]}°C" : "—" %>
              </span>
              <span data-unit-toggle-target="fahrenheit" class="<%= 'hidden' if @unit != 'F' %>">
                <%= @stats[:max_f].present? ? "#{@stats[:max_f]}°F" : "—" %>
              </span>
            </dd>
          </div>
        </dl>
        <footer class="border-t border-slate-800/80 pt-3 text-xs text-slate-400">
          Aggregated by <%= @range_meta[:bucket_label].downcase %>
        </footer>
      </article>
    </section>

    <section aria-labelledby="chart-heading" class="mb-8 rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-sm">
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 id="chart-heading" class="text-lg font-semibold text-white">
            Current Temperature (<span data-unit-toggle-target="celsius" class="<%= 'hidden' if @unit == 'F' %>">°C</span><span data-unit-toggle-target="fahrenheit" class="<%= 'hidden' if @unit != 'F' %>">°F</span>)
          </h2>
          <p class="text-xs text-slate-400">
            Showing <%= @range_meta[:label].downcase %> (<%= @range_meta[:bucket_label].downcase %>)
          </p>
        </div>

        <div role="group" aria-label="Time range filter" class="inline-flex rounded-xl bg-slate-950 p-1 ring-1 ring-inset ring-slate-800">
          <% DashboardController::VALID_RANGES.each_key do |range_key| %>
            <% active = (@range == range_key) %>
            <%= link_to range_key,
                  root_path(range: range_key, device_id: params[:device_id]),
                  class: "rounded-lg px-3.5 py-1.5 text-xs font-semibold transition #{active ? 'bg-sky-500 text-slate-950 shadow-sm' : 'text-slate-400 hover:text-white'}" %>
          <% end %>
        </div>
      </div>

      <% if @chart_data.present? %>
        <div class="rounded-xl bg-slate-950/50 p-4">
          <%= line_chart @chart_data,
                id: "temperature-chart",
                height: "340px",
                suffix: (@unit == "F" ? "°F" : "°C"),
                colors: ["#38bdf8"],
                curve: true,
                points: false,
                empty: "No temperature readings in this time window",
                library: {
                  scales: {
                    x: {
                      ticks: { color: "#94a3b8" },
                      grid: { color: "rgba(148, 163, 184, 0.08)" }
                    },
                    y: {
                      ticks: { color: "#94a3b8" },
                      grid: { color: "rgba(148, 163, 184, 0.12)" }
                    }
                  }
                } %>
        </div>
      <% else %>
        <div class="flex h-64 flex-col items-center justify-center rounded-xl border border-dashed border-slate-800 bg-slate-950/40 p-6 text-center">
          <p class="text-sm font-medium text-slate-300">No readings recorded in the <%= @range_meta[:label].downcase %>.</p>
          <p class="mt-1 text-xs text-slate-500">Try selecting a wider time range or wait for the next Android bridge upload.</p>
        </div>
      <% end %>
    </section>

    <section aria-labelledby="cottage-photo-heading" class="mb-8 rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-sm">
      <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 id="cottage-photo-heading" class="text-lg font-semibold text-white">Latest Cottage Photo</h2>
          <p class="text-xs text-slate-400">Periodic daytime camera captures from the Android bridge</p>
        </div>

        <% if @latest_photo %>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-md bg-slate-800 px-2.5 py-1 font-mono text-slate-300">
              <%= @latest_photo.lens %>
            </span>
            <% if @latest_photo.width.present? && @latest_photo.height.present? %>
              <span class="rounded-md bg-slate-800 px-2.5 py-1 font-mono text-slate-400">
                <%= @latest_photo.width %>×<%= @latest_photo.height %>
              </span>
            <% end %>
            <% if @latest_photo.current_temp_c.present? %>
              <span class="rounded-md bg-sky-500/15 px-2.5 py-1 font-mono font-semibold text-sky-300 ring-1 ring-inset ring-sky-500/30">
                <span data-unit-toggle-target="celsius" class="<%= 'hidden' if @unit == 'F' %>">
                  <%= sprintf("%.1f°C", @latest_photo.current_temp_c) %>
                </span>
                <span data-unit-toggle-target="fahrenheit" class="<%= 'hidden' if @unit != 'F' %>">
                  <%= sprintf("%.1f°F", @latest_photo.current_temp_f) %>
                </span>
              </span>
            <% end %>
            <%= link_to "View all photos →", device_photos_path(@device),
                  class: "rounded-md bg-sky-500/10 px-2.5 py-1 font-medium text-sky-400 ring-1 ring-inset ring-sky-500/20 hover:bg-sky-500/20 transition" %>
          </div>
        <% end %>
      </div>

      <% if @latest_photo %>
        <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
          <%= link_to photo_path(@latest_photo), target: "_blank", rel: "noopener", class: "group relative block" do %>
            <img
              src="<%= photo_path(@latest_photo) %>"
              alt="Cottage photo captured at <%= friendly_timestamp(@latest_photo.recorded_at) %>"
              width="<%= @latest_photo.width || 1280 %>"
              height="<%= @latest_photo.height || 960 %>"
              decoding="async"
              class="aspect-4/3 max-h-[540px] w-full object-contain bg-slate-950 transition group-hover:opacity-95"
            >
            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-800/80 bg-slate-900/90 px-4 py-3 text-xs text-slate-300">
              <div>
                Captured <time datetime="<%= @latest_photo.recorded_at.iso8601 %>" class="font-semibold text-white"><%= time_ago_in_words(@latest_photo.recorded_at) %> ago</time>
                <span class="text-slate-400">(<%= friendly_timestamp(@latest_photo.recorded_at) %>)</span>
              </div>
              <span class="font-medium text-sky-400 group-hover:underline">Open full image ↗</span>
            </div>
          <% end %>
        </div>

        <% if @recent_photos.any? %>
          <div class="mt-5">
            <div class="mb-3 flex items-center justify-between">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Recent Captures</h3>
              <%= link_to "View all captures →", device_photos_path(@device),
                    class: "text-xs font-medium text-sky-400 hover:text-sky-300 hover:underline" %>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
              <% @recent_photos.each do |photo| %>
                <%= link_to photo_path(photo), target: "_blank", rel: "noopener",
                      class: "group overflow-hidden rounded-lg border border-slate-800 bg-slate-950 transition hover:border-sky-500/50" do %>
                  <img
                    src="<%= photo_path(photo) %>"
                    alt="Capture from <%= friendly_timestamp(photo.recorded_at) %>"
                    width="<%= photo.width || 1280 %>"
                    height="<%= photo.height || 960 %>"
                    loading="lazy"
                    decoding="async"
                    class="aspect-4/3 w-full object-cover transition group-hover:scale-105"
                  >
                  <div class="p-2 font-mono text-[11px] leading-tight">
                    <div class="truncate text-slate-200" title="<%= friendly_timestamp(photo.recorded_at) %>"><%= friendly_timestamp_short(photo.recorded_at) %></div>
                    <div class="mt-0.5 flex items-center justify-between text-slate-400">
                      <span><%= photo.lens %></span>
                      <% if photo.current_temp_c.present? %>
                        <span class="text-sky-300">
                          <span data-unit-toggle-target="celsius" class="<%= 'hidden' if @unit == 'F' %>">
                            <%= sprintf("%.1f°C", photo.current_temp_c) %>
                          </span>
                          <span data-unit-toggle-target="fahrenheit" class="<%= 'hidden' if @unit != 'F' %>">
                            <%= sprintf("%.1f°F", photo.current_temp_f) %>
                          </span>
                        </span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="flex h-48 flex-col items-center justify-center rounded-xl border border-dashed border-slate-800 bg-slate-950/40 p-6 text-center">
          <p class="text-sm font-medium text-slate-300">No daytime photos uploaded yet.</p>
          <p class="mt-1 text-xs text-slate-500">
            Photos sent to <code class="rounded bg-slate-900 px-1.5 py-0.5 font-mono text-xs text-sky-300">POST /api/v1/photos</code> will appear here.
          </p>
        </div>
      <% end %>
    </section>

    <% if @recent_readings.any? %>
      <section aria-labelledby="recent-readings-heading" class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-sm">
        <h2 id="recent-readings-heading" class="mb-4 text-base font-semibold text-white">Recent Telemetry Readings</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-800 text-xs uppercase tracking-wider text-slate-400">
              <tr>
                <th scope="col" class="pb-3 pr-4">Timestamp</th>
                <th scope="col" class="pb-3 px-4">Temp (°C)</th>
                <th scope="col" class="pb-3 pl-4">Temp (°F)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
              <% @recent_readings.each do |reading| %>
                <tr class="hover:bg-slate-800/30">
                  <td class="py-2.5 pr-4 text-slate-300"><%= friendly_timestamp(reading.recorded_at) %></td>
                  <td class="py-2.5 px-4 font-semibold text-white"><%= reading.current_temp_c.present? ? sprintf("%.1f°C", reading.current_temp_c) : "—" %></td>
                  <td class="py-2.5 pl-4 text-slate-400"><%= reading.current_temp_f.present? ? sprintf("%.1f°F", reading.current_temp_f) : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% else %>
    <section class="rounded-2xl border border-dashed border-slate-800 bg-slate-900/40 p-12 text-center">
      <h2 class="text-lg font-semibold text-white">No Thermostat Telemetry Received Yet</h2>
      <p class="mx-auto mt-2 max-w-lg text-sm text-slate-400">
        Send an authenticated <code class="rounded bg-slate-900 px-1.5 py-0.5 font-mono text-xs text-sky-300">POST /api/v1/telemetry</code> request from the Android bridge app to populate this dashboard.
      </p>
    </section>
  <% end %>
</div>
